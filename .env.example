# Telegram (@BotFather)
BOT_TOKEN=123456:ABC...

# Cursor → Dashboard → API Keys → https://cursor.com/dashboard
CURSOR_API_KEY=your_cursor_api_key

# Репозиторий по умолчанию (можно переопределить через /repo)
DEFAULT_REPO_URL=https://github.com/your-org/your-repo
DEFAULT_BRANCH=main

# Автоматически создавать PR после задачи
AUTO_CREATE_PR=true

# Лимит задач на пользователя в сутки (защита от злоупотреблений)
MAX_DAILY_RUNS=20

# Telegram user id админа (команда /status с диагностикой)
ADMIN_ID=0

# Пусто = бот открыт для всех. Иначе: 123,456,789
ALLOWED_USER_IDS=

# Путь к SQLite (на Railway подключите Volume)
DB_PATH=bot_data.sqlite3
